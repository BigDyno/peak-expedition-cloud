{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "peak-expedition-cloud",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "peak-races",
      "database_id": "c11f4cc4-6eff-4342-9ce1-eee1f4ac0be5",
      "migrations_dir": "migrations"
    }
  ],
  "previews": {
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "peak-races",
      "database_id": "c11f4cc4-6eff-4342-9ce1-eee1f4ac0be5"
    }
  ]
}
}
